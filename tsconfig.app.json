{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/calibration/calibrate.ts",
    "src/calibration/calibration.test.ts",
    // Imports the pure parseReview() out of the api/ serverless handler, whose
    // @vercel/node types would otherwise leak Node globals into this browser
    // program (making other tests' @ts-expect-error node-import guards unused).
    // Vitest still runs it. Keep it out of the DOM typecheck graph.
    "src/threat/parseReview.test.ts",
    "src/**/* 2.ts",
    "src/**/* 2.tsx"
  ]
}
